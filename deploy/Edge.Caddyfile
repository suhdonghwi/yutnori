jammy.fun, www.jammy.fun {
	@invariant_bare path /invariant
	redir @invariant_bare /invariant/ 308

	# Invariant Frog: a static build from ../invariant-frog/dist.
	handle_path /invariant/* {
		root * /srv/invariant-frog/dist
		encode zstd gzip
		# Z3's threads need a cross-origin isolated page.
		header Cross-Origin-Opener-Policy same-origin
		header Cross-Origin-Embedder-Policy require-corp
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control no-cache
		file_server
	}

	handle {
		reverse_proxy web:80
	}
}
